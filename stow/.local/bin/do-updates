#!/usr/bin/bash

set -euo pipefail

sudo apt update
sudo apt full-upgrade --auto-remove

if command -v flatpak 2>/dev/null; then
    sudo flatpak update --system -y
    flatpak update --user -y
fi

# opa has no apt package (see setup.d/install-opa), so its setup step does the
# update: it replaces an older opa with the latest release.
# This is stow/.local/bin/do-updates in the repo.
repo_root=$(dirname "$(dirname "$(dirname "$(dirname "$(readlink -f "$0")")")")")
"$repo_root/setup.d/install-opa"
