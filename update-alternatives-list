#!/usr/bin/bash

set -euo pipefail

# Save the alternatives you chose by hand that the shared alternatives.txt
# does not already set to hosts/<host>/alternatives.txt (see lib/host-lists).
# Automatic ones are left out, so a new machine makes its own choices for
# those. A host line overrides a shared line for the same name, since
# setup.d/190-update-alternatives applies the host file last.

repo_root=$(dirname "$(readlink -f "$0")")
# shellcheck source=lib/host-lists
. "$repo_root/lib/host-lists"

update-alternatives --get-selections | awk '$2 == "manual"' | write_host_list alternatives.txt
