#!/usr/bin/bash

# Regenerate this host's hosts/<host>/packages-leaves.txt: the apt packages
# you chose to install, with anything that arrived as a dependency filtered
# out, and anything already in the shared packages-leaves.txt left out too.
# The shared list is edited by hand and installed on every host; see
# lib/host-lists. Shared packages that are not installed here are reported.
#
# A package is listed when BOTH are true:
#   1. apt-mark reports it as manually installed, and
#   2. nothing else installed requires it -- or it is the representative of a
#      dependency cycle that nothing outside the cycle requires (see below).
#
# "Requires" covers Pre-Depends, Depends and Recommends. Recommends counts
# because apt installs recommended packages by default, so a recommended
# package would reappear on a fresh machine without being listed.
# install-packages-leaves therefore uses `apt-get install` without
# --no-install-recommends, which honours Recommends. Change one and you must
# change the other, or the list stops round-tripping.
#
# Alternatives and virtual packages: a group like `vim | vim-gtk3 | vim-tiny`
# only marks a package as required when exactly one installed package can
# satisfy it. If two alternatives are installed, neither is strictly required,
# so both stay on the list. Same rule for Provides.
#
# Dependency cycles: Debian packages are routinely mutually dependent
# (calibre <-> calibre-bin, gedit <-> gedit-common, language-pack-en <->
# language-pack-en-base). Every member of such a cycle is required by another
# member, so a plain "nothing requires it" test finds no leaf and drops the
# entire cycle from the list. This script instead checks what the kept set
# actually pulls in, and for any group left uncovered promotes one member --
# preferring a manually installed one -- so the cycle is reachable again.
#
# Packages no apt repository provides (leftovers from an older release, or
# .deb files installed by hand) are left out and printed as a warning: they
# can never be installed on a fresh machine, so listing them would only add
# permanent noise to install-packages-leaves' "not found" report. They are
# removed from the dependency graph before leaves are computed, so anything
# they alone required is judged on its own merits rather than dropped.
# That test needs apt's package lists, so their absence is a hard error: with
# empty lists every package looks unprovided and the whole list would be
# thrown away.
#
# Base system packages are never listed either: those marked Essential, the
# installer's tasks (Section: tasks, e.g. task-gnome-desktop), and those with
# Priority required or important (always installed) or standard (the
# installer's "standard system utilities"). Section and Priority are read from
# the archive index (apt's lists), not dpkg's database: the archive overrides
# what a package declares itself, and dpkg keeps the package's own value
# (netcat-traditional calls itself optional; the archive makes it standard).
# Priority only counts for packages
# from the distribution's own archive, since third-party repositories set it
# carelessly. The installer marks all of these as manually installed, but a
# fresh machine already has them. They stay in the dependency graph, so
# anything they require is not listed either.
#
# Packages named in packages-leaves-exclude.txt, or in this host's
# hosts/<host>/packages-leaves-exclude.txt, are never listed, and are taken
# out of the graph the same way. Entries are shell-style globs (*, ?,
# [...]), matched against the whole package name, so a plain name still
# matches only itself.

set -euo pipefail

# Byte-order collation so sort/comm/python agree on ordering, and so apt's
# output stays untranslated for parsing.
export LC_ALL=C

cd "$(dirname "$(readlink -f "$0")")"
repo_root=$PWD
# shellcheck source=lib/host-lists
. lib/host-lists

# Without package lists apt-cache policy offers only /var/lib/dpkg/status for
# every package, so all of them would look as though no repository provides
# them and the generated list would come out empty -- overwriting the real
# one. Same check as install-packages-leaves makes.
if ! compgen -G '/var/lib/apt/lists/*Packages*' > /dev/null; then
    printf 'apt has no package lists; every package would look unprovided.\n' >&2
    printf 'run: sudo apt-get update\n' >&2
    exit 2
fi

exclude_file=packages-leaves-exclude.txt

manual=$(mktemp)
pkgdata=$(mktemp)
archive=$(mktemp)
policy=$(mktemp)
sources=$(mktemp)
exclude=$(mktemp)
# Built in a temporary file and written out only once python3 has succeeded:
# writing the host list as it goes would truncate the existing one before the
# generator runs, losing it outright if python3 is missing or raises partway
# through.
draft=$(mktemp)
trap 'rm -f "$manual" "$pkgdata" "$archive" "$policy" "$sources" "$exclude" "$draft"' EXIT

wanted_list "$exclude_file" > "$exclude"

apt-mark showmanual | sort -u > "$manual"

# ${Package}, NOT ${binary:Package}: on a multiarch system the latter appends
# an arch qualifier ("gcc-14-base:amd64") while dependency fields use the bare
# name, so every multiarch package would look unreferenced and the list would
# balloon by ~1200 entries.
dpkg-query -Wf '${db:Status-Status}\t${Package}\t${Essential}\t${Provides}\t${Pre-Depends}, ${Depends}, ${Recommends}\n' > "$pkgdata"

# Where each installed package can be downloaded from, to spot the ones that
# exist only in the local dpkg database.
awk -F'\t' '$1 == "installed" { print $2 }' "$pkgdata" | xargs apt-cache policy > "$policy"

# Section and Priority of each installed package as the archive index gives
# them, which may differ from what dpkg recorded (see the header comment).
# One record per package: the candidate version's.
awk -F'\t' '$1 == "installed" { print $2 }' "$pkgdata" | xargs apt-cache show --no-all-versions |
    awk '/^Package: / { pkg = $2 } /^Section: / { sec[pkg] = $2 } /^Priority: / { pri[pkg] = $2 }
         END { for (p in pri) print p "\t" sec[p] "\t" pri[p] }' > "$archive"

# Every configured source with its origin, to tell the distribution's own
# packages from third-party ones.
apt-cache policy > "$sources"

python3 - "$pkgdata" "$archive" "$manual" "$policy" "$sources" "$exclude" "$exclude_file" <<'PYTHON' > "$draft"
import re
import sys
from collections import deque
from fnmatch import fnmatchcase

pkgdata_path, archive_path, manual_path, policy_path, sources_path, exclude_path, exclude_name = sys.argv[1:8]

STRIP = re.compile(r"\([^)]*\)|\[[^\]]*\]|<[^>]*>")
ARCH = re.compile(r":[A-Za-z0-9]+$")


def clean(name):
    """Reduce one dependency atom to a bare package name."""
    name = STRIP.sub("", name)          # version constraints, arch restrictions, profiles
    name = name.strip()
    return ARCH.sub("", name)           # multiarch qualifier: foo:any, foo:amd64


BASE_PRIORITIES = {"required", "important", "standard"}

installed = set()
base = set()        # part of every Debian install; see the header comment
base_priority = set()   # base by Priority, if the distribution's archive says so
provides = {}       # virtual or real name -> packages providing it
dep_groups = {}     # package -> list of groups, each group a list of atoms

archive = {}       # package -> (section, priority) from the archive index
with open(archive_path) as fh:
    for line in fh:
        name, section, priority = line.rstrip("\n").split("\t")
        # Sections outside main carry the component: "non-free-firmware/kernel".
        archive[name] = (section.split("/")[-1], priority)

with open(pkgdata_path) as fh:
    for line in fh:
        status, name, essential, prov, deps = line.rstrip("\n").split("\t")
        if status != "installed":       # skip config-files/half-installed states
            continue
        installed.add(name)
        section, priority = archive.get(name, ("", ""))
        if essential == "yes" or section == "tasks":
            base.add(name)
        elif priority in BASE_PRIORITIES:
            base_priority.add(name)
        dep_groups[name] = [
            [clean(atom) for atom in group.split("|")] for group in deps.split(",")
        ]
        for atom in prov.split(","):
            virtual = clean(atom)
            if virtual:
                provides.setdefault(virtual, set()).add(name)

# A package is obsolete when every line of its apt-cache policy version table
# points at /var/lib/dpkg/status, i.e. no configured repository offers any
# version of it. Headers look like "htop:" or, for a foreign arch, "libc6:i386:".
# Source lines are a priority then a URL or path. apt right-aligns the
# priority, so match on shape, not indentation: Pop!_OS pins its repo at 1001,
# which shifts the column. The "/" keeps an all-digit version line such as
# "20240118 500" from being mistaken for a source.
HEADER = re.compile(r"^(\S+?)(?::[A-Za-z0-9]+)?:$")
SOURCE = re.compile(r"^\s+-?\d+ ((\S*/\S*).*)$")
sourced = set()
pkg_sources = {}    # package -> its source lines, minus the priority
current = None
with open(policy_path) as fh:
    for line in fh:
        header = HEADER.match(line.rstrip("\n"))
        if header:
            current = header.group(1)
            continue
        source = SOURCE.match(line)
        if source and current and source.group(2) != "/var/lib/dpkg/status":
            sourced.add(current)
            pkg_sources.setdefault(current, set()).add(source.group(1).strip())

# Third-party repositories set Priority too, and not always sensibly
# (Microsoft's dotnet-sdk is "standard"), so Priority only counts for packages
# from the distribution's own archive: the origin base-files comes from. The
# global `apt-cache policy` names each source line's origin on the "release"
# line under it, e.g. "release v=13,o=Debian,a=stable,...".
origin_of = {}      # source line, minus the priority -> origin
with open(sources_path) as fh:
    last = None
    for line in fh:
        source = SOURCE.match(line)
        if source:
            last = source.group(1).strip()
            continue
        fields = line.strip()
        if last and fields.startswith("release "):
            for field in fields[len("release "):].split(","):
                if field.startswith("o="):
                    origin_of[last] = field[2:]
            last = None


def origins(pkg):
    return {origin_of[s] for s in pkg_sources.get(pkg, ()) if s in origin_of}


distro = origins("base-files")
base |= {pkg for pkg in base_priority if origins(pkg) & distro}

with open(exclude_path) as fh:
    patterns = [line.strip() for line in fh if line.strip()]
# fnmatchcase: package names are lowercase by policy, and plain fnmatch would
# fold case only on case-insensitive platforms.
excluded = {pkg for pkg in installed if any(fnmatchcase(pkg, pat) for pat in patterns)}

# Drop obsolete and excluded packages from the graph entirely: obsolete ones
# cannot exist on a fresh machine and excluded ones are unwanted, so neither
# may make anything else look "required".
obsolete = installed - sourced
removed = obsolete | excluded
installed -= removed
for pkg in removed:
    dep_groups.pop(pkg, None)
for virtual in provides:
    provides[virtual] -= removed

# pulls[pkg] = packages pkg is guaranteed to bring in. A dependency group only
# counts when exactly one installed package can satisfy it; if several
# alternatives are installed, none of them is individually required.
pulls = {pkg: set() for pkg in installed}
for pkg, groups in dep_groups.items():
    for group in groups:
        candidates = set()
        for atom in group:
            if not atom:
                continue
            if atom in installed:
                candidates.add(atom)
            candidates |= provides.get(atom, set()) & installed
        candidates.discard(pkg)
        if len(candidates) == 1:
            pulls[pkg] |= candidates

required = set().union(*pulls.values()) if pulls else set()
keep = installed - required


def reachable_from(seeds):
    """Everything the given packages drag in, transitively."""
    seen = set(seeds)
    queue = deque(seeds)
    while queue:
        for nxt in pulls.get(queue.popleft(), ()):
            if nxt not in seen:
                seen.add(nxt)
                queue.append(nxt)
    return seen


with open(manual_path) as fh:
    manual = {line.strip() for line in fh if line.strip()}

# Promote a representative for every group the kept set cannot reach. These are
# dependency cycles: each member is required by another member, so none of them
# qualified as a leaf. Manually installed members are preferred, so the
# representative survives the intersection with the manual set below.
# Only members of a top cycle qualify: one that no other uncovered package
# pulls in, except from inside the cycle. Otherwise a manually installed
# dependency of the cycle could be promoted first just for sorting earlier,
# and listed although the cycle brings it in.
covered = reachable_from(keep)
uncovered = installed - covered
reach = {pkg: reachable_from({pkg}) for pkg in uncovered}
tops = [
    pkg for pkg in uncovered
    if all(pkg not in reach[other] or other in reach[pkg] for other in uncovered)
]
for pkg in sorted(tops, key=lambda p: (p not in manual, p)):
    if pkg not in covered:
        keep.add(pkg)
        covered |= reachable_from({pkg})

for pkg in sorted((keep & manual) - base):
    print(pkg)

skipped = (keep & manual) & base
if skipped:
    print(f"skipped {len(skipped)} base system package(s) (Essential, tasks, or "
          f"Priority {'/'.join(sorted(BASE_PRIORITIES))})", file=sys.stderr)

if excluded:
    print(f"excluded per {exclude_name}: {' '.join(sorted(excluded))}", file=sys.stderr)

left_out = sorted(obsolete & manual)
if left_out:
    print(
        f"warning: left out {len(left_out)} manually installed package(s) that no\n"
        "apt repository provides. They are leftovers from an older release or\n"
        ".deb files installed by hand, and cannot be installed on a fresh machine:",
        file=sys.stderr,
    )
    for pkg in left_out:
        print(f"  {pkg}", file=sys.stderr)
    print(
        "if you no longer need them: sudo apt-mark auto <packages> && sudo apt autoremove",
        file=sys.stderr,
    )
PYTHON

write_host_list packages-leaves.txt < "$draft"

# Installed at all, not just a leaf: a shared package that something here
# depends on is still present.
missing=$(awk -F'\t' '$1 == "installed" { print $2 }' "$pkgdata" |
    missing_shared packages-leaves.txt | tr '\n' ' ')
if [[ -n $missing ]]; then
    printf 'shared packages not installed here (setup.d/050-install-packages-leaves installs them): %s\n' \
        "${missing% }" >&2
fi
