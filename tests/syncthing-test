#!/usr/bin/bash

# Tests for setup.d/syncthing with two throwaway Syncthing instances, one as
# jeeves and one as the machine being set up, each in its own home directory.
# A fake ssh runs jeeves's commands against the first. Checks pairing the
# devices, joining jeeves's folders by label, asking before merging a folder
# that has files, rerunning, refusing a folder already synced under another ID,
# adding the .git and node_modules ignore patterns, keeping any others, on both
# machines and away from home, and restricting Syncthing to the LAN and Tailscale.
# Needs Syncthing, jq and curl installed; needs no root, and runs in about 8
# seconds. The instances only listen on localhost and announce nothing: their
# global discovery server is unreachable, for when the test turns discovery on.
#
# Usage: tests/syncthing-test

# The folder paths are written with a literal ~, as Syncthing keeps them.
# shellcheck disable=SC2088

set -uo pipefail

repo=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
work=$(mktemp -d)

for cmd in syncthing jq curl; do
    if ! command -v "$cmd" >/dev/null; then
        echo "$cmd is not installed" >&2
        exit 1
    fi
done

# Keep Syncthing's config in the throwaway homes.
unset XDG_CONFIG_HOME XDG_STATE_HOME STHOMEDIR STCONFDIR STDATADIR

hub_home=$work/hub
client_home=$work/client

# The throwaway instances still running, found by their home directories.
instances() {
    local pid
    for pid in $(pgrep -x syncthing); do
        if grep -qzF "HOME=$work/" "/proc/$pid/environ" 2>/dev/null; then
            echo "$pid"
        fi
    done
}

# Ask both instances to shut down, and wait for them to exit.
stop_instances() {
    local home _
    for home in "$hub_home" "$client_home"; do
        HOME=$home syncthing cli operations shutdown >/dev/null 2>&1
    done
    for _ in $(seq 20); do
        [ -z "$(instances)" ] && return
        sleep 0.5
    done
    instances | xargs -r kill
}
trap 'stop_instances; rm -rf "$work"' EXIT

passed=0
failed=0

check() {
    local name=$1
    shift
    if "$@"; then
        passed=$((passed + 1))
    else
        failed=$((failed + 1))
        printf 'FAIL: %s\n' "$name"
        printf '  output:\n    %s\n' "${out//$'\n'/$'\n'    }"
    fi
}

# The last run's output has, or lacks, a line matching an extended regex.
has() { grep -qE -- "$1" <<<"$out"; }
lacks() { ! grep -qE -- "$1" <<<"$out"; }

# Device $1 is not among the lines that follow.
not_listed() { ! grep -qxF -- "$1" <<<"$2"; }

# Make an instance's keys and config, listening on localhost only and
# announcing nothing.
generate() {
    local config=$1/.local/state/syncthing/config.xml
    HOME=$1 syncthing generate --no-default-folder >/dev/null 2>&1
    sed -i -e 's|<listenAddress>default<|<listenAddress>tcp://127.0.0.1:0<|' \
        -e 's|<globalAnnounceServer>default<|<globalAnnounceServer>https://127.0.0.1:1/<|' \
        -e 's|<\(globalAnnounceEnabled\|localAnnounceEnabled\|relaysEnabled\|natEnabled\)>true<|<\1>false<|' \
        "$config"
}

hub() { HOME=$hub_home syncthing cli "$@"; }
client() { HOME=$client_home syncthing cli "$@"; }

wait_ready() {
    local _
    for _ in $(seq 30); do
        HOME=$1 syncthing cli show system >/dev/null 2>&1 && return 0
        sleep 0.5
    done
    return 1
}

# jeeves, with a Music folder kept at another path than ~/Music.
mkdir -p "$hub_home"
generate "$hub_home"
HOME=$hub_home setsid -f syncthing serve --no-browser --no-restart </dev/null >"$work/hub.log" 2>&1
if ! wait_ready "$hub_home"; then
    echo "The hub instance did not start; see:" >&2
    cat "$work/hub.log" >&2
    exit 1
fi
hub config folders add --id docs-1 --label Documents --path '~/Documents'
hub config folders add --id music-1 --label Music --path '~/music-elsewhere'
hub config folders add --id other-1 --label Other --path '~/Other'
hub_id=$(hub show system | jq -r .myID)

# Fake ssh and getent: jeeves.lan resolves, and ssh runs the command in the
# hub's home.
mkdir -p "$work/bin"
cat > "$work/bin/ssh" <<EOF
#!/usr/bin/bash
while [ \$# -gt 0 ]; do
    case \$1 in
        -o) shift 2 ;;
        -*) shift ;;
        *) break ;;
    esac
done
shift
HOME=$hub_home exec bash -c "\$*"
EOF
# With $AWAY set, it does not, as away from home.
cat > "$work/bin/getent" <<'EOF'
#!/usr/bin/bash
[ -z "${AWAY:-}" ] || exit 2
echo "127.0.0.1 jeeves.lan"
EOF
# A fake ip, so the home LAN is the same on any machine. With $NO_ROUTE set,
# there is no default route.
cat > "$work/bin/ip" <<'EOF'
#!/usr/bin/bash
if [ -n "${NO_ROUTE:-}" ]; then
    echo '[]'
elif [[ " $* " == *" default "* ]]; then
    echo '[{"dst":"default","gateway":"10.9.8.1","dev":"eth9"}]'
else
    echo '[{"dst":"10.9.8.0/24","dev":"eth9","protocol":"kernel","scope":"link"}]'
fi
EOF
# A fake tailscale, so the tailnet is the same on any machine. With $NO_TAILNET
# set, it is not running.
cat > "$work/bin/tailscale" <<'EOF'
#!/usr/bin/bash
[ -z "${NO_TAILNET:-}" ] || exit 1
echo '{"MagicDNSSuffix":"tailnet.example.ts.net"}'
EOF
chmod +x "$work/bin/ssh" "$work/bin/getent" "$work/bin/ip" "$work/bin/tailscale"

# A copy of the repo, as the host "test" with one profile.
dotfiles=$work/repo
# jeeves builds on the same profile.
mkdir -p "$dotfiles/setup.d" "$dotfiles/hosts/test" "$dotfiles/hosts/jeeves" "$dotfiles/profiles/desktop"
cp "$repo/setup.d/syncthing" "$dotfiles/setup.d/"
cp -r "$repo/lib" "$dotfiles/"
echo desktop > "$dotfiles/hosts/test/profiles.txt"
echo desktop > "$dotfiles/hosts/jeeves/profiles.txt"
printf '%s\n' '~/Documents' '~/Music' > "$dotfiles/profiles/desktop/syncthing-folders.txt"

# As on a fresh install, Music is empty; Documents is not.
mkdir -p "$client_home/Documents/old" "$client_home/Music"
echo old > "$client_home/Documents/notes.txt"
echo old > "$client_home/Documents/old/more.txt"
generate "$client_home"

# Run the step, with $1 as the answer to its prompts.
run() {
    out=$(HOME=$client_home DOTFILES_HOST=test PATH=$work/bin:$PATH \
        "$dotfiles/setup.d/syncthing" 2>&1 <<<"${1:-}")
    rc=$?
}

# The step run on jeeves.
run_hub() {
    out=$(HOME=$hub_home DOTFILES_HOST=jeeves PATH=$work/bin:$PATH \
        "$dotfiles/setup.d/syncthing" 2>&1 </dev/null)
    rc=$?
}

# The folders and devices in an instance's config.
folder_path() { "$1" config folders "$2" path get 2>/dev/null; }
folder_devices() { "$1" config folders "$2" devices list 2>/dev/null; }

# A folder's ignore patterns, one per line, through the instance's REST API.
#   st_api HOME PATH [CURL-ARGS...]
st_api() {
    local home=$1 path=$2
    shift 2
    curl -fsS -H "X-API-Key: $(HOME=$home syncthing cli config gui apikey get)" \
        "http://$(HOME=$home syncthing cli config gui raw-address get)/rest/$path" "$@"
}
#   folder_ignores HOME FOLDER
folder_ignores() { st_api "$1" "db/ignores?folder=$2" | jq -r '.ignore // [] | .[]'; }
#   set_ignores HOME FOLDER PATTERN...
set_ignores() {
    local home=$1 folder=$2
    shift 2
    jq -cn '{ignore: $ARGS.positional}' --args "$@" |
        st_api "$home" "db/ignores?folder=$folder" -d @- >/dev/null
}
# The ignore patterns the step adds, one per line.
added=$'(?d).git\n(?d)node_modules'

# A field of a device in an instance's config, as compact JSON.
#   device_field INSTANCE DEVICE FIELD
device_field() { "$1" config devices "$2" dump-json 2>/dev/null | jq -c ".$3"; }
# The networks the step allows, and the addresses it leaves on a device.
networks='["10.9.8.0/24","100.64.0.0/10","fd7a:115c:a1e0::/48"]'
addresses() { printf '["dynamic","tcp://%s.tailnet.example.ts.net:22000"]' "$1"; }
# Turn on what the step turns off, as on a machine it has not run on.
#   open_options INSTANCE
open_options() {
    local option
    for option in global-ann-enabled relays-enabled natenabled; do
        "$1" config options "$option" set true
    done
}
#   options_closed INSTANCE
options_closed() {
    [ "$("$1" config options global-ann-enabled get)" = false ] &&
        [ "$("$1" config options relays-enabled get)" = false ] &&
        [ "$("$1" config options natenabled get)" = false ]
}
# A new device's ID, from a throwaway home.
new_device_id() {
    HOME=$work/$1 syncthing generate --no-default-folder 2>&1 |
        grep -oEm1 '[A-Z0-9]{7}(-[A-Z0-9]{7}){7}'
}

run n
client_id=$(client show system 2>/dev/null | jq -r .myID)
check 'first run succeeds' [ "$rc" -eq 0 ]
check 'starts Syncthing' has '^Starting Syncthing$'
check 'adds the autostart entry' \
    cmp -s /usr/share/applications/syncthing-start.desktop "$client_home/.config/autostart/syncthing-start.desktop"
check 'adds jeeves as an introducer' [ "$(client config devices "$hub_id" introducer get 2>/dev/null)" = true ]
check 'adds the machine to jeeves' [ "$(hub config devices "$client_id" name get 2>/dev/null)" = test ]
check 'limits jeeves to the LAN and Tailscale' [ "$(device_field client "$hub_id" allowedNetworks)" = "$networks" ]
check 'and adds its tailnet address' [ "$(device_field client "$hub_id" addresses)" = "$(addresses jeeves)" ]
check 'and says so' has '^Restricting jeeves to the LAN and Tailscale$'
check 'jeeves limits the machine too' [ "$(device_field hub "$client_id" allowedNetworks)" = "$networks" ]
check 'and adds its tailnet address' [ "$(device_field hub "$client_id" addresses)" = "$(addresses test)" ]
check 'but not itself' [ "$(device_field client "$client_id" allowedNetworks)" = '[]' ]
check 'the empty Music joins without asking' [ "$(grep -c 'is not synced yet' <<<"$out")" -eq 1 ]
check 'Music is joined by label, at ~/Music' [ "$(folder_path client music-1)" = '~/Music' ]
check 'jeeves shares Music' grep -qxF "$client_id" <<<"$(folder_devices hub music-1)"
check 'Music ignores .git and node_modules' [ "$(folder_ignores "$client_home" music-1)" = "$added" ]
check 'and says so' has '^Ignoring \(\?d\)\.git and \(\?d\)node_modules in ~/Music$'
check 'an unlisted folder is not joined' [ -z "$(folder_path client other-1)" ]
check 'jeeves does not share Other' not_listed "$client_id" "$(folder_devices hub other-1)"
check 'asks about Documents, counting its files' has '^~/Documents is not synced yet, but has 2 files'
check 'and lists its top level' has '^    notes\.txt$'
check 'no skips Documents' [ -z "$(folder_path client docs-1)" ]
check 'and leaves jeeves unshared' not_listed "$client_id" "$(folder_devices hub docs-1)"
check 'and warns' has '^Warning: skipped ~/Documents'

run y
check 'yes succeeds' [ "$rc" -eq 0 ]
check 'Documents keeps its path' [ "$(folder_path client docs-1)" = '~/Documents' ]
check 'Documents is shared with jeeves' grep -qxF "$hub_id" <<<"$(folder_devices client docs-1)"
check 'jeeves shares Documents' grep -qxF "$client_id" <<<"$(folder_devices hub docs-1)"
check 'the merged Documents keeps its files' [ -f "$client_home/Documents/notes.txt" ]
check 'Documents ignores .git and node_modules' [ "$(folder_ignores "$client_home" docs-1)" = "$added" ]

run
check 'rerun succeeds' [ "$rc" -eq 0 ]
check 'rerun starts nothing' lacks 'Starting'
check 'rerun asks nothing' lacks 'is not synced yet'
check 'rerun adds nothing' lacks 'Adding|Sharing|Ignoring|Restricting|Turned off'

# As set up before the step restricted networks, with another address and
# network that stay.
open_options client
client config devices "$hub_id" addresses add tcp://10.0.0.1:22000
client config devices "$hub_id" allowed-networks add 10.0.0.0/8
run
check 'rerun with discovery on succeeds' [ "$rc" -eq 0 ]
check 'turns off discovery, relays and NAT' options_closed client
check 'and says so' has "^Turned off Syncthing's global discovery, relays and NAT port mapping$"
check 'keeps an address it did not add' \
    grep -qF tcp://10.0.0.1:22000 <<<"$(device_field client "$hub_id" addresses)"
check 'keeps a network it did not add' \
    grep -qF 10.0.0.0/8 <<<"$(device_field client "$hub_id" allowedNetworks)"

# As set up before the step added ignore patterns: other patterns, a comment,
# and one of the two.
set_ignores "$client_home" docs-1 '// mine' '*.tmp' '(?d).git'
run
check 'rerun with other ignores succeeds' [ "$rc" -eq 0 ]
check 'adds only the missing pattern' has '^Ignoring \(\?d\)node_modules in ~/Documents$'
check 'after the ones there, which are kept' \
    [ "$(folder_ignores "$client_home" docs-1)" = $'// mine\n*.tmp\n(?d).git\n(?d)node_modules' ]

# Away from home, the folders synced already still get them.
set_ignores "$client_home" music-1
laptop_id=$(new_device_id laptop)
client config devices add --device-id "$laptop_id" --name laptop
open_options client
AWAY=1 run
check 'away from home succeeds' [ "$rc" -eq 0 ]
check 'and skips pairing' has 'not found \(not on the home network\?\)'
check 'but adds the ignore patterns' [ "$(folder_ignores "$client_home" music-1)" = "$added" ]
check 'and turns off discovery, relays and NAT' options_closed client
check 'but leaves the devices, without the home LAN to look up' [ "$(device_field client "$laptop_id" allowedNetworks)" = '[]' ]

# Back home, the home LAN comes from jeeves, and a device left over is restricted.
run
check 'back home succeeds' [ "$rc" -eq 0 ]
check 'and restricts the device' [ "$(device_field client "$laptop_id" allowedNetworks)" = "$networks" ]

# Without the home LAN to allow, the step stops.
NO_ROUTE=1 run
check 'no route on jeeves fails' [ "$rc" -ne 0 ]
check 'and says why' has "^Cannot find the home LAN's network on jeeves$"

# Without the tailnet's name, a device is limited but gets no address on it,
# until a rerun finds the name.
desk_id=$(new_device_id desk)
client config devices add --device-id "$desk_id" --name desk
NO_TAILNET=1 run
check 'no tailnet on jeeves succeeds' [ "$rc" -eq 0 ]
check 'and warns' has "^Warning: cannot find the tailnet's name on jeeves"
check 'and still limits the device' [ "$(device_field client "$desk_id" allowedNetworks)" = "$networks" ]
check 'but adds no address' [ "$(device_field client "$desk_id" addresses)" = '["dynamic"]' ]
run
check 'a rerun adds the address' [ "$(device_field client "$desk_id" addresses)" = "$(addresses desk)" ]

# Devices jeeves has that were not set up by the step: one whose name differs in
# case from its hostname, and one whose name cannot be a hostname.
phone_id=$(new_device_id phone)
tablet_id=$(new_device_id tablet)
hub config devices add --device-id "$phone_id" --name Zehn
hub config devices add --device-id "$tablet_id" --name 'Some Tablet'
open_options hub

# On jeeves, the listed folders get them, by label; the others are left alone.
run_hub
check 'jeeves succeeds' [ "$rc" -eq 0 ]
check 'jeeves turns off discovery, relays and NAT' options_closed hub
check 'and limits its other devices' [ "$(device_field hub "$phone_id" allowedNetworks)" = "$networks" ]
check 'with their names lowercased in the address' [ "$(device_field hub "$phone_id" addresses)" = "$(addresses zehn)" ]
check 'a name that cannot be a hostname gets no address' [ "$(device_field hub "$tablet_id" addresses)" = '["dynamic"]' ]
check 'but is still limited' [ "$(device_field hub "$tablet_id" allowedNetworks)" = "$networks" ]
check 'and pairs nothing' has '^This is jeeves, the hub; no folders to pair$'
check 'its Music ignores .git and node_modules' [ "$(folder_ignores "$hub_home" music-1)" = "$added" ]
check 'named by its path' has '^Ignoring .* in ~/music-elsewhere$'
check 'an unlisted folder gets no ignores' [ -z "$(folder_ignores "$hub_home" other-1)" ]
run_hub
check 'jeeves rerun adds nothing' lacks 'Ignoring|Restricting|Turned off'

# A folder at a listed path, synced under another ID.
client config folders add --id pics-9 --label Pictures --path '~/Pictures'
hub config folders add --id pics-1 --label Pictures --path '~/Pictures'
echo '~/Pictures' >> "$dotfiles/profiles/desktop/syncthing-folders.txt"
run
check 'another ID at the path fails' [ "$rc" -ne 0 ]
check 'and says which' has 'already synced as folder pics-9'
check 'and leaves jeeves unshared' not_listed "$client_id" "$(folder_devices hub pics-1)"

printf '%d passed, %d failed\n' "$passed" "$failed"
[ "$failed" -eq 0 ]
