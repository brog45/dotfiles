#!/usr/bin/bash

set -euo pipefail

script=$(readlink -f "$0")
script_dir=$(dirname "$script")
repo_root=$(dirname "$script_dir")
# shellcheck source=lib/host-lists
. "$repo_root/lib/host-lists"
# shellcheck source=lib/desktop
. "$repo_root/lib/desktop"

# Flatpaks are desktop apps; a headless machine such as a print server gets
# neither them nor flatpak itself.
require_desktop "installing flatpaks"

sudo apt install -y flatpak

# Let GNOME Software browse and update flatpaks. GNOME is optional: the plugin
# would pull in GNOME Software, so it is installed here rather than listed in
# packages-leaves.txt.
if [ "$(dpkg-query -W -f '${db:Status-Status}' gnome-shell 2>/dev/null)" = installed ]; then
    sudo apt install -y gnome-software-plugin-flatpak
fi

flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# The shared flatpaks.txt plus this host's hosts/<host>/flatpaks.txt.
mapfile -t flatpaks < <(wanted_list flatpaks.txt)
if [ ${#flatpaks[@]} -gt 0 ]; then
    sudo flatpak install --system -y "${flatpaks[@]}"
fi

