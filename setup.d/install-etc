#!/usr/bin/bash

set -euo pipefail

# Copy system config into /etc at the same paths: etc/ at the repo root, in
# each of this host's profiles, and in hosts/<host>/ (see lib/host-lists).
# Where two of them have the same file, the later one wins, so a host can
# override its profiles. Only files that differ are written, so rerunning is
# a no-op; files in /etc that the repo does not mention are left alone.
# Unit files in /etc/systemd/system/ with an [Install] section are enabled,
# and started when new or changed; changed udev rules are applied at once.
#
# Prefer drop-in directories such as /etc/systemd/logind.conf.d/ over
# replacing a package's own config file, so package upgrades never conflict.

script=$(readlink -f "$0")
repo_root=$(dirname "$(dirname "$script")")
# shellcheck source=lib/host-lists
. "$repo_root/lib/host-lists"

# Map each /etc path to the file that wins it.
declare -A source_of=()
for dir in "${list_dirs[@]}"; do
    [ -d "$dir/etc" ] || continue
    while IFS= read -r -d '' file; do
        source_of[/etc/${file#"$dir"/etc/}]=$file
    done < <(find "$dir/etc" -type f -print0)
done

if [ ${#source_of[@]} -eq 0 ]; then
    echo "No etc/ files for $host; nothing to install into /etc"
    exit 0
fi

udev_changed=0
systemd_changed=0
units=()            # unit files in /etc/systemd/system/ itself
declare -A unit_changed=()
while IFS= read -r -d '' dest; do
    file=${source_of[$dest]}
    if [[ $dest == /etc/systemd/system/*.* && $dest != /etc/systemd/system/*/* ]]; then
        units+=("${dest##*/}")
    fi
    if cmp -s "$file" "$dest"; then
        echo "$dest is up to date"
    else
        echo "Installing $dest from ${file#"$repo_root"/}"
        sudo install -D -m 644 "$file" "$dest"
        [[ $dest == /etc/udev/rules.d/* ]] && udev_changed=1
        [[ $dest == /etc/systemd/system/* ]] && systemd_changed=1
        unit_changed[${dest##*/}]=1
    fi
done < <(printf '%s\0' "${!source_of[@]}" | sort -z)

# Apply new udev rules now rather than at the next boot.
if [ $udev_changed -eq 1 ]; then
    echo "Reloading udev rules"
    sudo udevadm control --reload
    sudo udevadm trigger
fi

# Load new or changed units, then enable each one that has an [Install]
# section. Start a unit only when it is newly enabled or changed, so a rerun
# does not restart one you stopped. --no-block, so a mount whose device is
# unplugged does not hold up setup.
if [ $systemd_changed -eq 1 ]; then
    echo "Reloading systemd units"
    sudo systemctl daemon-reload
fi
for unit in "${units[@]}"; do
    grep -q '^\[Install\]' "/etc/systemd/system/$unit" || continue
    start=${unit_changed[$unit]:-0}
    if [ "$(systemctl is-enabled "$unit" 2>/dev/null)" != enabled ]; then
        echo "Enabling $unit"
        sudo systemctl enable "$unit"
        start=1
    fi
    if [ "$start" -eq 1 ]; then
        echo "Starting $unit"
        sudo systemctl restart --no-block "$unit"
    fi
done
