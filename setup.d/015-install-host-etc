#!/usr/bin/bash

set -euo pipefail

# Copy this host's system config, hosts/<host>/etc/ (see lib/host-lists), into
# /etc at the same paths. Only files that differ are written, so rerunning is
# a no-op; files in /etc that the repo does not mention are left alone.
#
# Prefer drop-in directories such as /etc/systemd/logind.conf.d/ over
# replacing a package's own config file, so package upgrades never conflict.

script=$(readlink -f "$0")
repo_root=$(dirname "$(dirname "$script")")
# shellcheck source=lib/host-lists
. "$repo_root/lib/host-lists"

src=$host_dir/etc
if [ ! -d "$src" ]; then
    echo "No ${src#"$repo_root"/}; nothing to install into /etc"
    exit 0
fi

find "$src" -type f -print0 | sort -z | while IFS= read -r -d '' file; do
    dest=/etc/${file#"$src"/}
    if cmp -s "$file" "$dest"; then
        echo "$dest is up to date"
    else
        echo "Installing $dest"
        sudo install -D -m 644 "$file" "$dest"
    fi
done
