#!/usr/bin/bash

set -euo pipefail

# Add the SSH key from 090 to your GitHub account, so git can use
# git@github.com:... remotes. Signs in to GitHub with the gh CLI, which opens
# the browser (made the default by 080) to approve the login.

key=~/.ssh/id_ed25519

if [ ! -f "$key.pub" ]; then
    echo "No SSH key $key.pub; run 090-ssh-key first" >&2
    exit 1
fi

if ! command -v gh >/dev/null; then
    sudo apt install -y gh
fi

# gh does not request these scopes by default: admin:public_key to add the
# key, and user:email so 110-setup-git can read your email address. During
# login gh may offer to upload the key itself; either answer is fine, since the
# next step adds it if it is still missing.
scopes=admin:public_key,user:email
if ! gh auth status --hostname github.com >/dev/null 2>&1; then
    gh auth login --hostname github.com --git-protocol ssh --web --scopes "$scopes"
elif ! gh api user/keys >/dev/null 2>&1 || ! gh api user/emails >/dev/null 2>&1; then
    gh auth refresh --hostname github.com --scopes "$scopes"
fi

# Compare type and key, not the comment, which GitHub does not store.
if gh api user/keys --jq '.[].key' | grep -xF "$(cut -d' ' -f1,2 "$key.pub")" >/dev/null; then
    echo "The key is already on your GitHub account"
else
    gh ssh-key add "$key.pub" --title "$(hostname)"
fi

# Trust GitHub's host keys as published by its API (fetched over HTTPS), rather
# than accepting whatever key answers on first connection.
if ! ssh-keygen -F github.com >/dev/null; then
    gh api meta --jq '.ssh_keys[]' | sed 's/^/github.com /' >> ~/.ssh/known_hosts
fi

# GitHub answers with a greeting and exit status 1, since it gives no shell,
# so check the greeting rather than the exit status.
greeting=$(ssh -T git@github.com 2>&1 || true)
if [[ $greeting == *'successfully authenticated'* ]]; then
    echo "SSH to GitHub works"
else
    echo "Could not authenticate to GitHub over SSH" >&2
    exit 1
fi
