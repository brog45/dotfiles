#!/usr/bin/bash

set -euo pipefail

# Start Syncthing when you log in, and sync the folders that
# syncthing-folders.txt in this host's profiles or hosts/<host>/ lists (see
# lib/host-lists) with jeeves, the hub. Each folder joins jeeves's folder whose
# label is the directory's name, wherever jeeves keeps it, and jeeves is made
# an introducer, so the other machines sharing those folders with it are added
# too. Configures jeeves over SSH, with the key that jeeves-ssh-key authorized.
# A folder that is not synced yet but already has files (on a fresh install it
# is empty) is listed, and joins only if you say so: its files are then merged
# with jeeves's, and a file that differs on both sides is kept as a
# .sync-conflict copy. Nothing is ever deleted. Each folder, on jeeves too,
# ignores .git and node_modules directories: the patterns for them are added to
# its ignore patterns if missing, after any it has, which are kept. Syncthing
# connects only over the home LAN and Tailscale: global discovery, relays and
# NAT port mapping are turned off, and each other device in its config, on
# jeeves too, is limited to those networks and given its address on the tailnet.
# The LAN's network and the tailnet's name are looked up on jeeves, so away from
# home the devices are left for a rerun from home. If this machine's record of what jeeves has looks out of date, it offers to
# have every connected machine send its full index again.

script=$(readlink -f "$0")
repo_root=$(dirname "$(dirname "$script")")
# shellcheck source=lib/host-lists
. "$repo_root/lib/host-lists"
# shellcheck source=lib/terminal
. "$repo_root/lib/terminal"
# shellcheck source=lib/syncthing
. "$repo_root/lib/syncthing"

hub=jeeves
hub_host=jeeves.lan

if ! command -v syncthing >/dev/null; then
    echo "Syncthing is not installed; skipping"
    exit 0
fi

# The entry the package installs for this, copied as is so a later package
# version cannot leave a stale copy behind unnoticed.
entry=/usr/share/applications/syncthing-start.desktop
if [ -f "$entry" ]; then
    mkdir -p ~/.config/autostart
    if ! cmp -s "$entry" ~/.config/autostart/syncthing-start.desktop; then
        cp "$entry" ~/.config/autostart/
        echo "Syncthing will start when you log in"
    fi
else
    echo "Warning: no $entry; add Syncthing to your startup applications by hand" >&2
fi

# Wait up to 30 seconds for Syncthing to answer.
wait_ready() {
    local _
    for _ in $(seq 30); do
        if syncthing cli show system >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    echo "Syncthing did not start" >&2
    return 1
}

# Start Syncthing the way the autostart entry does.
start_syncthing() {
    setsid -f syncthing serve --no-browser --logfile=default </dev/null >/dev/null 2>&1 3>&-
    wait_ready
}

# Start Syncthing now too, so it can be configured. On the first start, make
# its keys and config first, without the default ~/Sync folder; this keeps any
# that exist.
if ! syncthing cli show system >/dev/null 2>&1; then
    syncthing generate --no-default-folder
    echo "Starting Syncthing"
    start_syncthing
fi

mapfile -t folders < <(read_lists syncthing-folders.txt)
if [ ${#folders[@]} -eq 0 ]; then
    echo "No syncthing-folders.txt for $host; no folders to sync"
    exit 0
fi

for cmd in curl jq; do
    if ! command -v "$cmd" >/dev/null; then
        sudo apt install -y "$cmd"
    fi
done

st_api_init

# Patterns for every synced folder, so that .git and node_modules directories
# stay on each machine. (?d) lets Syncthing delete a directory that holds only
# these.
ignores=('(?d).git' '(?d)node_modules')

# Add whichever of $ignores a folder's ignore patterns lack, after the ones it
# has, which are kept as they are. A pattern counts as there when it is in
# .stignore or in a file that .stignore includes.
#   ensure_ignores ID PATH
ensure_ignores() {
    local id=$1 path=$2 query current missing
    query="db/ignores?folder=$(uri "$id")"
    current=$(st_api "$query")
    missing=$(jq -c '$ARGS.positional - (.expanded // [])' --args "${ignores[@]}" <<<"$current")
    if [ "$missing" = '[]' ]; then
        return
    fi
    echo "Ignoring $(jq -r 'join(" and ")' <<<"$missing") in $path"
    jq -c --argjson m "$missing" '{ignore: ((.ignore // []) + $m)}' <<<"$current" |
        st_api "$query" -d @- >/dev/null
}

# The ID of the one folder labeled LABEL; fails if there is none, or more than
# one.
#   folder_by_label "$config" LABEL
folder_by_label() {
    jq -er --arg l "$2" '[.folders[] | select(.label == $l) | .id] | if length == 1 then .[0] else empty end' <<<"$1"
}

# The ID of a folder at PATH; fails if there is none. Syncthing keeps a
# leading ~ as given, so this compares expanded paths.
#   folder_by_path "$config" PATH
folder_by_path() {
    jq -er --arg home "$HOME" --arg p "${2/#\~/$HOME}" \
        'first(.folders[] | select((.path | sub("^~"; $home) | rtrimstr("/")) == ($p | rtrimstr("/"))) | .id)' <<<"$1"
}

# Tailscale's IPv4 and IPv6 ranges. The IPv6 one is not this LAN's or specific
# to this tailnet: Tailscale documents it publicly
# (https://tailscale.com/kb/1015/100.x-addresses), so it is not a secret.
tailscale_networks=(100.64.0.0/10 fd7a:115c:a1e0::/48)

# The network of this machine's default route. Run on jeeves, which is always at
# home, to find the home LAN: this machine may be on someone else's network.
home_lan() {
    local dev
    dev=$(ip -j -4 route show default | jq -r '.[0].dev // empty')
    if [ -n "$dev" ]; then
        ip -j -4 route show dev "$dev" proto kernel scope link | jq -r '.[0].dst // empty'
    fi
}

# The tailnet's DNS domain, which is private and so not kept in this repo. Run
# on jeeves too: this machine may not be on Tailscale yet. Prints nothing if
# jeeves is not on it.
tailnet_domain() {
    tailscale status --json 2>/dev/null | jq -r '.MagicDNSSuffix // empty'
}

# Set the domain of the devices' addresses on the tailnet. Without one, they get
# no such address until a rerun finds it.
#   set_tailnet DOMAIN
set_tailnet() {
    tailnet=$1
    if [ -z "$tailnet" ]; then
        echo "Warning: cannot find the tailnet's name on $hub; adding no addresses on it" >&2
    fi
}

# Set the networks Syncthing may use: the home LAN and Tailscale.
#   set_allowed_networks HOME-LAN
set_allowed_networks() {
    if [ -z "$1" ]; then
        echo "Cannot find the home LAN's network on $hub" >&2
        exit 1
    fi
    allowed_networks=("$1" "${tailscale_networks[@]}")
}

# Turn off the ways of reaching a device outside the allowed networks.
restrict_options() {
    local option changed=
    for option in global-ann-enabled relays-enabled natenabled; do
        if [ "$(syncthing cli config options "$option" get)" != false ]; then
            syncthing cli config options "$option" set false
            changed=1
        fi
    done
    if [ -n "$changed" ]; then
        echo "Turned off Syncthing's global discovery, relays and NAT port mapping"
    fi
}

# Run `syncthing cli` on this machine, for restrict_device.
on_self() {
    syncthing cli "$@"
}

# Limit a device to $allowed_networks, and add its address on the tailnet, unless
# the tailnet is unknown or its name cannot be a hostname. Its other addresses
# stay: with global discovery off, dynamic finds it only on the LAN. CLI is
# on_self or on_hub.
#   restrict_device CLI ID NAME
restrict_device() {
    local cli=$1 id=$2 name=$3 device address network changed=
    device=$("$cli" config devices "$id" dump-json)
    if [ -n "$tailnet" ] && [[ ${name,,} =~ ^[a-z0-9-]+$ ]]; then
        address=tcp://${name,,}.$tailnet:22000
        if ! jq -e --arg a "$address" 'any(.addresses[]; . == $a)' <<<"$device" >/dev/null; then
            "$cli" config devices "$id" addresses add "$address"
            changed=1
        fi
    fi
    for network in "${allowed_networks[@]}"; do
        if ! jq -e --arg n "$network" 'any((.allowedNetworks // [])[]; . == $n)' <<<"$device" >/dev/null; then
            "$cli" config devices "$id" allowed-networks add "$network"
            changed=1
        fi
    done
    if [ -n "$changed" ]; then
        echo "Restricting $name to the LAN and Tailscale"
    fi
}

my_config=$(syncthing cli config dump-json)
my_id=$(syncthing cli show system | jq -r .myID)

# Restrict every other device in this machine's config.
restrict_devices() {
    local id name
    while IFS=$'\t' read -r id name; do
        restrict_device on_self "$id" "$name"
    done < <(jq -r --arg me "$my_id" '.devices[] | select(.deviceID != $me) | [.deviceID, .name] | @tsv' <<<"$my_config")
}

restrict_options

if [ "$host" = "$hub" ]; then
    set_allowed_networks "$(home_lan)"
    set_tailnet "$(tailnet_domain)"
    restrict_devices
    for path in "${folders[@]}"; do
        label=$(basename "$path")
        if ! id=$(folder_by_label "$my_config" "$label"); then
            echo "$hub has no folder, or more than one, labeled $label" >&2
            exit 1
        fi
        ensure_ignores "$id" "$(jq -r --arg f "$id" '.folders[] | select(.id == $f) | .path' <<<"$my_config")"
    done
    echo "This is $hub, the hub; no folders to pair"
    exit 0
fi

# The folders synced already get the ignore patterns even away from home.
for path in "${folders[@]}"; do
    if id=$(folder_by_path "$my_config" "$path"); then
        ensure_ignores "$id" "$path"
    fi
done

# jeeves is only reachable on the home network.
if ! getent hosts "$hub_host" >/dev/null; then
    echo "Warning: $hub_host not found (not on the home network?); skipping" >&2
    echo "Rerun $0 from home to sync with $hub" >&2
    exit 0
fi
if ! ssh -n -o BatchMode=yes -o ConnectTimeout=5 "$hub_host" true; then
    echo "Cannot SSH to $hub_host with a key; run jeeves-ssh-key first" >&2
    exit 1
fi

# Run `syncthing cli` on jeeves. -n, so ssh leaves this script's stdin alone.
on_hub() {
    ssh -n -o BatchMode=yes "$hub_host" "syncthing cli $(printf '%q ' "$@")"
}

# Call jeeves's REST API, sending lib/syncthing's functions along.
#   on_hub_api PATH
on_hub_api() {
    ssh -n -o BatchMode=yes "$hub_host" \
        "$(declare -f st_api_init st_api); st_api_init && st_api $(printf '%q' "$1")"
}

# Run one of this script's functions on jeeves, sending it along.
#   on_hub_function NAME
on_hub_function() {
    ssh -n -o BatchMode=yes "$hub_host" "$(declare -f "$1"); $1"
}

if ! hub_id=$(on_hub show system | jq -r .myID); then
    echo "Syncthing is not running on $hub" >&2
    exit 1
fi
hub_config=$(on_hub config dump-json)

set_allowed_networks "$(on_hub_function home_lan)"
set_tailnet "$(on_hub_function tailnet_domain)"
restrict_devices

#   has_device "$config" DEVICE
has_device() {
    jq -e --arg d "$2" 'any(.devices[]; .deviceID == $d)' <<<"$1" >/dev/null
}

#   folder_has_device "$config" FOLDER DEVICE
folder_has_device() {
    jq -e --arg f "$2" --arg d "$3" \
        'any(.folders[]; .id == $f and any(.devices[]; .deviceID == $d))' <<<"$1" >/dev/null
}

if ! has_device "$hub_config" "$my_id"; then
    echo "Adding $host to $hub"
    on_hub config devices add --device-id "$my_id" --name "$host"
fi
if ! has_device "$my_config" "$hub_id"; then
    echo "Adding $hub, as an introducer"
    syncthing cli config devices add --device-id "$hub_id" --name "$hub" --introducer
else
    syncthing cli config devices "$hub_id" introducer set true
fi
restrict_device on_hub "$my_id" "$host"
restrict_device on_self "$hub_id" "$hub"

# Ask a question on the terminal. No answer (no terminal) means no.
#   ask_yes QUESTION
ask_yes() {
    local reply
    read -r -p "$1 [y/N] " reply 2>&3 || reply=
    [[ $reply == [yY] || $reply == [yY][eE][sS] ]]
}

# Show what is already in a folder that is about to join, and ask whether to
# merge it.
#   confirm_merge PATH DIR LABEL
confirm_merge() {
    local path=$1 dir=$2 label=$3 count
    count=$(find "$dir" -mindepth 1 -not -type d | wc -l)
    to_terminal
    {
        echo "$path is not synced yet, but has $count files. Its top level:"
        find "$dir" -mindepth 1 -maxdepth 1 -printf '    %P\n' | LC_ALL=C sort | head -n 20
        if [ "$(find "$dir" -mindepth 1 -maxdepth 1 | wc -l)" -gt 20 ]; then
            echo "    ..."
        fi
    } >&3
    ask_yes "Merge them into $hub's $label? Otherwise $path is skipped."
}

synced=()
synced_ids=()
skipped=()
for path in "${folders[@]}"; do
    label=$(basename "$path")
    if ! id=$(folder_by_label "$hub_config" "$label"); then
        echo "$hub has no folder, or more than one, labeled $label" >&2
        exit 1
    fi

    if ! jq -e --arg f "$id" 'any(.folders[]; .id == $f)' <<<"$my_config" >/dev/null; then
        if other=$(folder_by_path "$my_config" "$path"); then
            echo "$path is already synced as folder $other, not $hub's $id;" \
                "remove it in the Syncthing web UI and rerun $0" >&2
            exit 1
        fi
        dir=${path/#\~/$HOME}
        if [ -n "$(find "$dir" -mindepth 1 -print -quit 2>/dev/null)" ] &&
            ! confirm_merge "$path" "$dir" "$label"; then
            echo "Skipping $path, which has files; rerun $0 to merge it"
            skipped+=("$path")
            continue
        fi
        echo "Adding $path ($hub's folder $id)"
        syncthing cli config folders add --id "$id" --label "$label" --path "$path"
        my_config=$(syncthing cli config dump-json)
        # Before sharing, so it never sends or fetches what it ignores.
        ensure_ignores "$id" "$path"
    fi

    if ! folder_has_device "$my_config" "$id" "$hub_id"; then
        syncthing cli config folders "$id" devices add --device-id "$hub_id"
    fi
    if ! folder_has_device "$hub_config" "$id" "$my_id"; then
        echo "Sharing $hub's $label with $host"
        on_hub config folders "$id" devices add --device-id "$my_id"
    fi
    synced+=("$path")
    synced_ids+=("$id")
done

if [ ${#synced[@]} -gt 0 ]; then
    echo "Syncing ${synced[*]} with $hub; the first sync can take a while"
fi
if [ ${#skipped[@]} -gt 0 ]; then
    echo "Warning: skipped ${skipped[*]}, which already had files" >&2
fi

# Shut Syncthing down, and wait for it to let go of its database: starting
# another before then fails. The process holding it is the one serving the GUI.
stop_syncthing() {
    local pid _
    pid=$(ss -Hltnp "sport = :${st_gui_url##*:}" | grep -om1 'pid=[0-9]*' | cut -d= -f2)
    if [ -z "$pid" ]; then
        echo "Cannot find the Syncthing serving ${st_gui_url#*//}" >&2
        return 1
    fi
    syncthing cli operations shutdown >/dev/null
    for _ in $(seq 30); do
        if ! kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        sleep 1
    done
    echo "Syncthing did not shut down" >&2
    return 1
}

# Restart Syncthing with --reset-deltas, so that every connected machine sends
# its full index again. That flag acts as Syncthing starts, but its monitor
# would pass it on to every restart after, so a short-lived instance without
# the monitor (--no-restart) does the reset.
reset_deltas() {
    local pid
    echo "Restarting Syncthing to reset its delta indexes"
    stop_syncthing
    syncthing serve --no-browser --no-restart --reset-deltas </dev/null >/dev/null 2>&1 3>&- &
    pid=$!
    wait_ready
    syncthing cli operations shutdown >/dev/null
    wait "$pid" || true
    start_syncthing
}

# This machine's record of what jeeves has can go stale, missing items jeeves
# holds. It then counts them as items jeeves needs, and the web UI shows jeeves
# out of sync while every folder here is up to date. Rescanning and restarting
# do not help, a full index exchange does, so offer one when, with jeeves
# connected and both sides idle, this machine thinks jeeves needs items in a
# folder that jeeves, asked directly, needs nothing in.
stale=()
if st_api system/connections | jq -e --arg d "$hub_id" '.connections[$d].connected' >/dev/null; then
    for i in "${!synced_ids[@]}"; do
        query="folder=$(uri "${synced_ids[$i]}")"
        needed=$(st_api "db/completion?$query&device=$hub_id" | jq '.needItems + .needDeletes')
        if [ "$needed" -eq 0 ] || [ "$(st_api "db/status?$query" | jq -r .state)" != idle ]; then
            continue
        fi
        if on_hub_api "db/status?$query" |
            jq -e '.state == "idle" and .needTotalItems == 0 and .needDeletes == 0' >/dev/null; then
            stale+=("${synced[$i]}: $needed items")
        fi
    done
fi
if [ ${#stale[@]} -gt 0 ]; then
    to_terminal
    {
        echo "This machine thinks $hub needs items that $hub says it has, in"
        printf '    %s\n' "${stale[@]}"
        echo "Its record of what $hub has looks out of date. Restarting Syncthing with"
        echo "--reset-deltas has every connected machine send its full index again;"
        echo "no files change."
    } >&3
    if ask_yes "Restart Syncthing to reset?"; then
        reset_deltas
    else
        echo "Warning: $hub looks out of sync; rerun $0 to reset" >&2
    fi
fi
