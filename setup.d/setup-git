#!/usr/bin/bash

set -euo pipefail

# Configure git: default branch main, and the commit author from your GitHub
# account (your profile name and primary verified email). Keeps an author name
# and email already in your git config; otherwise signs in with gh (unless
# github-ssh-key already did), and asks only for what GitHub does not have.

git config --global init.defaultBranch main

# Use SSH (and the key added by github-ssh-key) for https://github.com/ URLs
# too, so pushing to a repo cloned over HTTPS does not ask for a username.
git config --global url."git@github.com:".insteadOf "https://github.com/"

name=$(git config --global --get user.name || true)
email=$(git config --global --get user.email || true)
if [ -n "$name" ] && [ -n "$email" ]; then
    echo "Git commits will be authored by $name <$email> (already configured)"
    exit 0
fi

# github-ssh-key skips the gh login when SSH to GitHub already works, so log in
# here if needed. user:email lets gh read your email addresses.
if ! command -v gh >/dev/null; then
    sudo apt install -y gh
fi
if ! gh auth status --hostname github.com >/dev/null 2>&1; then
    gh auth login --hostname github.com --git-protocol ssh --web --scopes user:email
elif ! gh api user/emails >/dev/null 2>&1; then
    gh auth refresh --hostname github.com --scopes user:email
fi

name=$(gh api user --jq '.name // empty')
email=$(gh api user/emails --jq '.[] | select(.primary and .verified) | .email')

if [ -z "$name" ]; then
    default_name=$(git config --global --get user.name || getent passwd "$USER" | cut -d: -f5 | cut -d, -f1)
    read -r -p "No name on your GitHub profile. Git author name [$default_name]: " name
    name=${name:-$default_name}
fi

while [ -z "$email" ]; do
    read -r -p "No verified primary email on GitHub. Git author email: " email
done

git config --global user.name "$name"
git config --global user.email "$email"

echo "Git commits will be authored by $name <$email>"
