#!/usr/bin/bash

set -euo pipefail

# Link files into your home directory with GNU Stow, from stow/ at the repo
# root (every host), stow/ in each of this host's profiles, and
# hosts/<host>/stow/ (see lib/host-lists). Each file must be in only one of
# them: stow refuses to replace a link another one made.

repo_root=$(dirname "$(dirname "$(readlink -f "$0")")")
# shellcheck source=lib/host-lists
. "$repo_root/lib/host-lists"

# This is the first step, so on a fresh install apt's package lists may be as
# old as the install media; update them before installing.
if ! command -v stow >/dev/null; then
    sudo apt-get update
    sudo apt-get install -y stow
fi

# Remove the broken links into this repo that block stowing $1/stow. Such a
# link is left over from a file that moved, from one stow/ to another (or from
# the old base/), and stow treats a link into another of these trees as one it
# does not own. The link can be at the file's own path or, from a stow run
# without --no-folding, at one of its directories, so check each on the way.
remove_stale_links() {
    local file path part dest
    local -a parts
    while IFS= read -r -d '' file; do
        IFS=/ read -r -a parts <<<"${file#"$1"/stow/}"
        path=~
        for part in "${parts[@]}"; do
            path+=/$part
            if [ -L "$path" ]; then
                dest=$(realpath -m -- "$path")
                if [ ! -e "$path" ] && [[ $dest == "$repo_root"/* ]]; then
                    echo "Removing $path, a broken link to ${dest#"$repo_root"/}"
                    rm -- "$path"
                fi
                break
            fi
            [ -d "$path" ] || break
        done
    done < <(find "$1/stow" \( -type f -o -type l \) -print0)
}

for dir in "${list_dirs[@]}"; do
    [ -d "$dir/stow" ] || continue
    remove_stale_links "$dir"
    # --no-folding creates the subdirectories, so stow only links the files
    stow -v --no-folding -d "$dir" -t ~ stow
done
