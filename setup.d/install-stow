#!/usr/bin/bash

set -euo pipefail

# Link files into your home directory with GNU Stow, from stow/ at the repo
# root (every host), stow/ in each of this host's profiles, and
# hosts/<host>/stow/ (see lib/host-lists). Each file must be in only one of
# them: stow refuses to replace a link another one made.

repo_root=$(dirname "$(dirname "$(readlink -f "$0")")")
# shellcheck source=lib/host-lists
. "$repo_root/lib/host-lists"

# This is the first step, so on a fresh install apt's package lists may be as
# old as the install media; update them before installing.
if ! command -v stow >/dev/null; then
    sudo apt-get update
    sudo apt-get install -y stow
fi

# Remove the broken links into this repo, which block stowing. Such a link is
# left over from a file that moved, from one stow/ to another (or from the old
# base/), or that was deleted; stow treats a link into another of these trees
# as one it does not own. Stow writes relative links, so match the repo's
# directory name in the target: "dotfiles/..." for a link directly in ~,
# ".../dotfiles/..." deeper down. An unreadable directory under ~ is not worth
# failing setup over; a link find could not remove still makes stow fail.
repo_name=$(basename "$repo_root")
find ~ -xdev -xtype l \( -lname "$repo_name/*" -o -lname "*/$repo_name/*" \) \
    -delete -print || true

for dir in "${list_dirs[@]}"; do
    [ -d "$dir/stow" ] || continue
    # --no-folding creates the subdirectories, so stow only links the files
    stow -v --no-folding -d "$dir" -t ~ stow
done
