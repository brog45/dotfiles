#!/usr/bin/bash

set -euo pipefail

repo_root=$(dirname "$(dirname "$(readlink -f "$0")")")
# shellcheck source=lib/terminal
. "$repo_root/lib/terminal"

# Add the SSH key from ssh-key to your GitHub account, so git can use
# git@github.com:... remotes. If SSH to GitHub already works with the key, does
# nothing more; otherwise signs in to GitHub with the gh CLI, which opens the
# browser (made the default by default-browser) to approve the login.

key=~/.ssh/id_ed25519

if [ ! -f "$key.pub" ]; then
    echo "No SSH key $key.pub; run ssh-key first" >&2
    exit 1
fi

for cmd in curl jq; do
    if ! command -v "$cmd" >/dev/null; then
        sudo apt install -y "$cmd"
    fi
done

# Trust GitHub's host keys as published by its API (fetched over HTTPS), rather
# than accepting whatever key answers on first connection. The endpoint is
# public, so this needs no login.
if ! ssh-keygen -F github.com >/dev/null; then
    curl -fsSL https://api.github.com/meta | jq -r '.ssh_keys[]' | sed 's/^/github.com /' >> ~/.ssh/known_hosts
fi

# GitHub answers with a greeting and exit status 1, since it gives no shell,
# so check the greeting rather than the exit status. Offer only this key, so
# another key in the agent cannot make it pass.
ssh_works() {
    local greeting
    greeting=$(ssh -T -o BatchMode=yes -o IdentitiesOnly=yes -i "$key" git@github.com 2>&1 || true)
    [[ $greeting == *'successfully authenticated'* ]]
}

if ssh_works; then
    echo "SSH to GitHub already works with $key"
    exit 0
fi

if ! command -v gh >/dev/null; then
    sudo apt install -y gh
fi

# gh does not request these scopes by default: admin:public_key to add the
# key, and user:email so setup-git can read your email address. During
# login gh may offer to upload the key itself; either answer is fine, since the
# next step adds it if it is still missing.
scopes=admin:public_key,user:email
# gh shows a one-time code and waits for Enter, so it needs the terminal.
if ! gh auth status --hostname github.com >/dev/null 2>&1; then
    to_terminal
    gh auth login --hostname github.com --git-protocol ssh --web --scopes "$scopes" >&3 2>&3
elif ! gh api user/keys >/dev/null 2>&1 || ! gh api user/emails >/dev/null 2>&1; then
    to_terminal
    gh auth refresh --hostname github.com --scopes "$scopes" >&3 2>&3
fi

# Compare type and key, not the comment, which GitHub does not store.
if gh api user/keys --jq '.[].key' | grep -xF "$(cut -d' ' -f1,2 "$key.pub")" >/dev/null; then
    echo "The key is already on your GitHub account"
else
    gh ssh-key add "$key.pub" --title "$(hostname)"
fi

if ssh_works; then
    echo "SSH to GitHub works"
else
    echo "Could not authenticate to GitHub over SSH" >&2
    exit 1
fi
