# shellcheck shell=bash
# Shared and per-host lists, sourced by the update-* scripts and the setup.d
# scripts that install from them. The sourcing script must set repo_root.
#
# Each kind of list (packages-leaves.txt, flatpaks.txt, vscode-extensions.txt,
# alternatives.txt, packages-leaves-exclude.txt) has a shared file at the repo
# root, used on every machine, and may have a file of the same name in
# hosts/<host>/, used only on that host. The host is the short hostname, or
# $DOTFILES_HOST when set.
#
# The update-* scripts write only the host file: whatever this machine has
# that the shared file does not. They never change a shared file; moving an
# entry there is done by hand, and they point out entries that another host
# lists too, which are the likely candidates.
#
# Needs only bash, coreutils, sed and hostname, so it works on a bare machine.

host=${DOTFILES_HOST:-$(hostname -s)}
# shellcheck disable=SC2154  # repo_root is set by the sourcing script
host_dir=$repo_root/hosts/$host

# Print a list file without # comments, surrounding whitespace or blank
# lines. A missing file is an empty list.
read_list() {
    [[ -f $1 ]] || return 0
    sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$1" | sed '/^$/d'
}

# Print the shared and this host's entries of a list, sorted and deduplicated.
#   wanted_list flatpaks.txt
wanted_list() {
    { read_list "$repo_root/$1"; read_list "$host_dir/$1"; } | LC_ALL=C sort -u
}

# Print the shared entries of a list missing from stdin, e.g. shared flatpaks
# that are not installed here.
#   flatpak list --columns=app --app | missing_shared flatpaks.txt
missing_shared() {
    LC_ALL=C comm -23 <(read_list "$repo_root/$1" | LC_ALL=C sort -u) <(LC_ALL=C sort -u)
}

# Write hosts/<host>/NAME from this machine's full list on stdin, leaving out
# entries already in the shared NAME.
#   flatpak list --columns=app --app | write_host_list flatpaks.txt
write_host_list() {
    local name=$1 out=$host_dir/$1 entries other common
    entries=$(LC_ALL=C comm -23 <(LC_ALL=C sort -u | sed '/^$/d') <(read_list "$repo_root/$name" | LC_ALL=C sort -u))
    if [[ -z $entries ]]; then
        # Nothing beyond the shared list: no file, rather than an empty one.
        rm -f "$out"
        printf '%s: nothing beyond the shared %s\n' "${out#"$repo_root"/}" "$name"
        return
    fi
    mkdir -p "$host_dir"
    printf '%s\n' "$entries" > "$out"
    printf '%s: %d entries\n' "${out#"$repo_root"/}" "$(wc -l < "$out")"

    for other in "$repo_root"/hosts/*/"$name"; do
        [[ -f $other && $other != "$out" ]] || continue
        common=$(LC_ALL=C comm -12 "$out" <(read_list "$other" | LC_ALL=C sort -u) | tr '\n' ' ')
        if [[ -n $common ]]; then
            printf 'also listed for %s (move them to %s if every host should have them): %s\n' \
                "$(basename "$(dirname "$other")")" "$name" "${common% }" >&2
        fi
    done
}
